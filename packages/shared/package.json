{
  "name": "@koed/shared",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration-contract.d.ts",
      "import": "./dist/collaboration-contract.js"
    },
    "./personal-desktop": {
      "types": "./dist/personal-desktop-contract.d.ts",
      "import": "./dist/personal-desktop-contract.js"
    },
    "./secure-upstream-fetch": {
      "types": "./dist/secure-upstream-fetch.d.ts",
      "import": "./dist/secure-upstream-fetch.js"
    },
    "./ai-client-contract": {
      "types": "./dist/ai-client-contract.d.ts",
      "import": "./dist/ai-client-contract.js"
    }
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "json-canonicalize": "2.0.0",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  }
}
