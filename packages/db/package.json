{
  "name": "@koed/db",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "drizzle/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "api-token:create": "pnpm run build && node scripts/create-api-token.mjs",
    "api-token:list": "pnpm run build && node scripts/list-api-tokens.mjs",
    "api-token:revoke": "pnpm run build && node scripts/revoke-api-token.mjs",
    "migrate:generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate:check": "drizzle-kit check --config drizzle.config.ts",
    "migrate:acceptance": "pnpm run build && node scripts/migration-smoke.mjs",
    "migrate:smoke": "pnpm run migrate:acceptance",
    "migrate:up": "pnpm run build && node dist/migrate-cli.js",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koed/core": "workspace:*",
    "@koed/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
