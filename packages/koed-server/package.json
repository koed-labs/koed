{
  "name": "@koed-labs/server",
  "version": "0.10.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "koed": "dist/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./desktop-component-manager": {
      "types": "./dist/desktop-component-manager.d.ts",
      "import": "./dist/desktop-component-manager.js"
    }
  },
  "dependencies": {
    "@koed/shared": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "commander": "15.0.0",
    "proper-lockfile": "4.1.2",
    "zod": "^4.1.12"
  },
  "scripts": {
    "prepublishOnly": "node -e \"throw new Error('Publish assembled artifact only; source workspace publication blocked')\"",
    "build": "node scripts/build.mjs && node ../../scripts/embed-component-manifest-catalog.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/cli.js start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/proper-lockfile": "4.1.4"
  }
}
