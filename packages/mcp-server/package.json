{
  "name": "@koed/mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "koed-memory-answer-bridge": "dist/answer-bridge.js",
    "koed-mcp": "dist/cli.js",
    "koed-capture-hook": "dist/capture-hook.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./codex-transcript-parser": {
      "types": "./dist/codex-transcript-parser.d.ts",
      "import": "./dist/codex-transcript-parser.js"
    }
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force && node scripts/copy-prompts.mjs",
    "bundle": "pnpm run build && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/koed-mcp-bundled.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "node dist/cli.js",
    "answer-bridge": "node dist/answer-bridge.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koed/core": "workspace:*",
    "@koed/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
