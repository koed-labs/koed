{
  "name": "@koed/evals",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "eval": "tsc -b tsconfig.json && node dist/index.js",
    "eval:memory-recall:live": "tsc -b tsconfig.json && node dist/memory-recall/live-runner.js",
    "eval:tool-choice": "tsc -b tsconfig.json && node dist/tool-choice/index.js",
    "eval:tool-choice:live": "tsc -b tsconfig.json && node dist/tool-choice/live-runner.js",
    "eval:curated-memory-intake": "tsc -b tsconfig.json && node dist/curated-memory-intake/index.js",
    "eval:curated-memory-intake:workflow": "pnpm --filter @koed/api build && pnpm --filter @koed/mcp-server build && tsc -b tsconfig.json && node dist/curated-memory-intake/live-runner.js",
    "eval:lcm-summary:live": "tsc -b tsconfig.json && node dist/lcm-summary-generation/live-runner.js",
    "eval:retrieval-success": "tsc -b tsconfig.json && node dist/retrieval-success/index.js",
    "eval:retrieval-success:live": "tsc -b tsconfig.json && node dist/retrieval-success/live-runner.js",
    "eval:workers": "tsc -b tsconfig.json && node dist/worker-json/index.js",
    "test": "tsc -b tsconfig.json && vitest run --passWithNoTests",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@koed/api": "workspace:*",
    "@koed/core": "workspace:*",
    "@koed/db": "workspace:*",
    "@koed/mcp-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "zod": "^4.4.3"
  }
}
