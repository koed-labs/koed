{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@koed-labs/api": ["./apps/api/src/server/index.ts"],
      "@koed-labs/core": ["./packages/core/src/index.ts"],
      "@koed-labs/db": ["./packages/db/src/index.ts"],
      "@koed-labs/server": ["./packages/koed-server/src/index.ts"],
      "@koed-labs/mcp-server": ["./packages/mcp-server/src/index.ts"],
      "@koed-labs/mcp-server/mcp-server-factory": [
        "./packages/mcp-server/src/mcp-server-factory.ts"
      ],
      "@koed-labs/mcp-server/codex-transcript-parser": [
        "./packages/mcp-server/src/codex-transcript-parser.ts"
      ],
      "@koed-labs/mcp-server/claude-transcript-parser": [
        "./packages/mcp-server/src/claude-transcript-parser.ts"
      ],
      "@koed-labs/mcp-server/runtime-contracts": [
        "./packages/mcp-server/src/runtime-contracts.ts"
      ],
      "@koed-labs/shared": ["./packages/shared/src/index.ts"],
      "@koed-labs/shared/personal-project-default": [
        "./packages/shared/src/personal-project-default.ts"
      ],
      "@koed-labs/shared/personal-local-folders": [
        "./packages/shared/src/personal-local-folders.ts"
      ],
      "@koed-labs/shared/ai-client-connections": [
        "./packages/shared/src/ai-client-connections.ts"
      ],
      "@koed-labs/shared/ai-client-contract": [
        "./packages/shared/src/ai-client-contract.ts"
      ],
      "@koed-labs/shared/collaboration": [
        "./packages/shared/src/collaboration-contract.ts"
      ],
      "@koed-labs/shared/collaboration-client-runtime": [
        "./packages/shared/src/collaboration-client-runtime.ts"
      ],
      "@koed-labs/shared/durable-realtime": [
        "./packages/shared/src/durable-realtime.ts"
      ],
      "@koed-labs/shared/execution-checkout": [
        "./packages/shared/src/execution-checkout.ts"
      ],
      "@koed-labs/shared/personal-desktop": [
        "./packages/shared/src/personal-desktop-contract.ts"
      ],
      "@koed-labs/shared/secure-upstream-fetch": [
        "./packages/shared/src/secure-upstream-fetch.ts"
      ],
      "@koed-labs/worker/embedding-workflow": [
        "./apps/worker/src/embedding-workflow.ts"
      ],
      "@koed-labs/worker/command-discovery-adapter": [
        "./apps/worker/src/command-discovery-adapter.ts"
      ],
      "@koed-labs/worker/command-discovery-adapter-codex": [
        "./apps/worker/src/command-discovery-adapter-codex.ts"
      ],
      "@koed-labs/worker/command-discovery-adapter-claude": [
        "./apps/worker/src/command-discovery-adapter-claude.ts"
      ],
      "@koed-labs/worker/command-discovery-adapter-pi": [
        "./apps/worker/src/command-discovery-adapter-pi.ts"
      ],
      "@koed-labs/shared/repository-recall": [
        "./packages/shared/src/repository-recall.ts"
      ],
      "@koed-labs/shared/repository-review": [
        "./packages/shared/src/repository-review.ts"
      ],
      "*": ["./*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
