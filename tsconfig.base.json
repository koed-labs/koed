{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@koed/api": ["apps/api/src/server/index.ts"],
      "@koed/core": ["packages/core/src/index.ts"],
      "@koed/db": ["packages/db/src/index.ts"],
      "@koed-labs/server": ["packages/koed-server/src/index.ts"],
      "@koed/mcp-server": ["packages/mcp-server/src/index.ts"],
      "@koed/mcp-server/mcp-server-factory": [
        "packages/mcp-server/src/mcp-server-factory.ts"
      ],
      "@koed/mcp-server/codex-transcript-parser": [
        "packages/mcp-server/src/codex-transcript-parser.ts"
      ],
      "@koed/mcp-server/claude-transcript-parser": [
        "packages/mcp-server/src/claude-transcript-parser.ts"
      ],
      "@koed/mcp-server/runtime-contracts": [
        "packages/mcp-server/src/runtime-contracts.ts"
      ],
      "@koed/shared": ["packages/shared/src/index.ts"],
      "@koed/shared/ai-client-contract": [
        "packages/shared/src/ai-client-contract.ts"
      ],
      "@koed/shared/agent-contract": ["packages/shared/src/agent-contract.ts"],
      "@koed/shared/project-source-contract": [
        "packages/shared/src/project-source-contract.ts"
      ],
      "@koed/shared/collaboration": [
        "packages/shared/src/collaboration-contract.ts"
      ],
      "@koed/shared/collaboration-client-runtime": [
        "packages/shared/src/collaboration-client-runtime.ts"
      ],
      "@koed/shared/durable-realtime": [
        "packages/shared/src/durable-realtime.ts"
      ],
      "@koed/shared/execution-checkout": [
        "packages/shared/src/execution-checkout.ts"
      ],
      "@koed/shared/personal-desktop": [
        "packages/shared/src/personal-desktop-contract.ts"
      ],
      "@koed/shared/secure-upstream-fetch": [
        "packages/shared/src/secure-upstream-fetch.ts"
      ],
      "@koed/worker/embedding-workflow": [
        "apps/worker/src/embedding-workflow.ts"
      ],
      "@koed/worker/project-source-extraction-contract": [
        "apps/worker/src/project-source-extraction-contract.ts"
      ],
      "@koed/worker/project-source-extractor": [
        "apps/worker/src/project-source-extractor.ts"
      ],
      "@koed/worker/project-source-extractor-client": [
        "apps/worker/src/project-source-extractor-client.ts"
      ],
      "@koed/worker/project-source-extractor-thread": [
        "apps/worker/src/project-source-extractor-thread.ts"
      ],
      "@koed/worker/command-discovery-adapter": [
        "apps/worker/src/command-discovery-adapter.ts"
      ],
      "@koed/worker/command-discovery-adapter-codex": [
        "apps/worker/src/command-discovery-adapter-codex.ts"
      ],
      "@koed/worker/command-discovery-adapter-claude": [
        "apps/worker/src/command-discovery-adapter-claude.ts"
      ],
      "@koed/worker/command-discovery-adapter-pi": [
        "apps/worker/src/command-discovery-adapter-pi.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
