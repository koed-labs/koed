[Unit]
Description=Koed hosted Postgres backup and restore verification
Documentation=https://github.com/koed-labs/koed/blob/main/docs/hosted-backups.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/koed
EnvironmentFile=/etc/koed/koed-server.env
Environment=KOED_BACKUP_DIR=/var/backups/koed/postgres
Environment=KOED_BACKUP_STATUS_PATH=/var/lib/koed/backup-status.json
Environment=KOED_BACKUP_RESTORE_DATABASE_URL=postgres://koed_restore:replace-me@127.0.0.1:5432/koed_restore
Environment=KOED_BACKUP_RESTORE_DATABASE_NAME=koed_restore
ExecStart=/opt/koed/examples/systemd/koed-hosted-backup-run.sh
User=koed
Group=koed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups/koed /var/lib/koed /tmp
