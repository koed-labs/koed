# API dev environment
# Values here use the names read by the API process directly.

# @root API_NODE_ENV=production
NODE_ENV=development
# @root omit
API_HOST=127.0.0.1
# @root omit
API_PORT=3300
# @root API_LOG_LEVEL
LOG_LEVEL=info

# @root omit
KOED_DEPLOYMENT_PROFILE=developer
# @root omit
KOED_RUNTIME_MODE=developer
# @root omit
KOED_DEPENDENCY_MODE=external
# Team collaboration is an explicit opt-in. When false, Personal Memory plus
# Personal notes, channels, realtime, and the local broker remain available.
# Team, Shared Memory, Team realtime, high-risk, support, lifecycle, retention,
# Cross-Identity Sync, enrollment, and upstream local-edge routes fail closed.
# @root KOED_TEAM_COLLABORATION_ENABLED
KOED_TEAM_COLLABORATION_ENABLED=false
# Developer-only escape hatch for an isolated local Team backend. Other
# deployment profiles ignore this value.
# @root KOED_DEVELOPER_TEAM_BACKEND_ENABLED
KOED_DEVELOPER_TEAM_BACKEND_ENABLED=false

# Docker compose derives this from the Postgres service settings.
# @root omit
DATABASE_URL=postgres://koed:koed@localhost:15432/koed

# Docker compose derives this from the Redis service when WORK_QUEUE_BACKEND=bullmq.
# @root omit
REDIS_URL=redis://localhost:6379
# @root WORK_QUEUE_BACKEND
WORK_QUEUE_BACKEND=bullmq

# @root API_DATA_ENCRYPTION_KEY
DATA_ENCRYPTION_KEY=replace_with_generated_32_byte_base64_key
# Leave blank to disable app-layer envelope encryption. Set to `local_test_key`
# only for local development/private alpha fixtures; hosted deployments should
# use a KMS-backed provider.
# @root API_ENVELOPE_ENCRYPTION_PROVIDER
API_ENVELOPE_ENCRYPTION_PROVIDER=
# @root KOED_MANAGED_CLOUD_RELEASE_STAGE
KOED_MANAGED_CLOUD_RELEASE_STAGE=alpha
# @root MANAGED_KMS_KEY_ID
MANAGED_KMS_KEY_ID=
# @root MANAGED_KMS_KEY_VERSION
MANAGED_KMS_KEY_VERSION=
# @root MANAGED_KMS_ENDPOINT_URL
MANAGED_KMS_ENDPOINT_URL=
# @root MANAGED_KMS_AUTH_TOKEN
MANAGED_KMS_AUTH_TOKEN=
# @root OWNER_PRIVATE_REPLICA_DATA_ENCRYPTION_KEY
OWNER_PRIVATE_REPLICA_DATA_ENCRYPTION_KEY=replace_with_generated_32_byte_base64_key
# Owner-private replicas use a separate provider family and never fall back to
# the Team/general provider. Leave blank to infer `local_test_key` from the key.
# @root OWNER_PRIVATE_REPLICA_ENVELOPE_ENCRYPTION_PROVIDER
OWNER_PRIVATE_REPLICA_ENVELOPE_ENCRYPTION_PROVIDER=
# @root OWNER_PRIVATE_REPLICA_MANAGED_KMS_KEY_ID
OWNER_PRIVATE_REPLICA_MANAGED_KMS_KEY_ID=
# @root OWNER_PRIVATE_REPLICA_MANAGED_KMS_KEY_VERSION
OWNER_PRIVATE_REPLICA_MANAGED_KMS_KEY_VERSION=
# @root OWNER_PRIVATE_REPLICA_MANAGED_KMS_ENDPOINT_URL
OWNER_PRIVATE_REPLICA_MANAGED_KMS_ENDPOINT_URL=
# @root OWNER_PRIVATE_REPLICA_MANAGED_KMS_AUTH_TOKEN
OWNER_PRIVATE_REPLICA_MANAGED_KMS_AUTH_TOKEN=
API_TOKEN_PEPPER=replace_with_generated_token_pepper
# Required for Personal collaboration realtime even when Team collaboration is disabled.
COLLABORATION_REALTIME_CURSOR_SECRET=replace_with_generated_realtime_cursor_secret
COLLABORATION_LOCAL_BROKER_SECRET=replace_with_generated_local_broker_secret

# Docker compose derives this from the embedding-service service.
# @root omit
EMBEDDING_SERVICE_URL=http://localhost:8000
# @root omit
EMBEDDING_SERVICE_TOKEN=replace_with_generated_embedding_service_token
# @root EMBEDDING_SERVICE_HEALTH_TIMEOUT_MS
EMBEDDING_SERVICE_HEALTH_TIMEOUT_MS=1000
# The optional Docker Compose external starter gets these from the embedding-service app example.
# @root EMBEDDING_MODEL_KEY
EMBEDDING_MODEL=qwen3-0.6b
# @root EMBEDDING_QUERY_INSTRUCTION_ENABLED
EMBEDDING_QUERY_INSTRUCTION_ENABLED=true
# @root EMBEDDING_QUERY_INSTRUCTION
EMBEDDING_QUERY_INSTRUCTION=
# Leave blank to disable reranking.
# @root EMBEDDING_RERANKER_KEY
RERANKER_KEY=
MEMORY_VECTOR_CANDIDATE_LIMIT=20
MEMORY_RAG_ROLLUP_CANDIDATE_LIMIT=
MEMORY_RAG_LEAF_CANDIDATE_LIMIT=
MEMORY_RAG_FRESH_EVENT_CANDIDATE_LIMIT=
MEMORY_RAG_RAW_FALLBACK_CANDIDATE_LIMIT=
MEMORY_RAG_LEXICAL_CANDIDATE_LIMIT=
MEMORY_RAG_ROLLUP_RESULT_LIMIT=
MEMORY_RAG_SCOPED_LEAF_CANDIDATE_LIMIT=
MEMORY_RAG_RAW_FALLBACK_ENABLED=true
MEMORY_PLAINTEXT_LEXICAL_SEARCH_ENABLED=
MEMORY_RAG_ROLLUP_MIN_SCORE=
MEMORY_RAG_SCOPED_LEAF_MIN_SCORE=
MEMORY_RAG_LEAF_MIN_SCORE=
MEMORY_RAG_FRESH_EVENT_MIN_SCORE=
MEMORY_RAG_RAW_FALLBACK_MIN_SCORE=
MEMORY_LCM_LEAF_EVENT_THRESHOLD=100
MEMORY_LCM_LEAF_TOKEN_THRESHOLD=32768
MEMORY_LCM_FRESH_EVENT_TAIL=10
MEMORY_LCM_COMPACTION_MAX_EVENTS=1000
MEMORY_LCM_DEPTH1_FANOUT=20
MEMORY_EVENT_MAX_TOKENS=2048
MEMORY_AGENT_TURN_STALE_MS=900000
# @root SEMANTIC_MEMORY_REBUILD_DEBOUNCE_MS
SEMANTIC_MEMORY_REBUILD_DEBOUNCE_MS=300000

# @root API_CORS_ORIGINS
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# @root omit
PUBLIC_APP_URL=
# @root omit
API_BASE_URL=

# @root API_REQUEST_BODY_LIMIT_BYTES
REQUEST_BODY_LIMIT_BYTES=4194304
# @root API_AUTH_RATE_LIMIT_WINDOW_MS
AUTH_RATE_LIMIT_WINDOW_MS=60000
# @root API_AUTH_RATE_LIMIT_MAX
AUTH_RATE_LIMIT_MAX=20
# @root API_MEMORY_RATE_LIMIT_WINDOW_MS
MEMORY_RATE_LIMIT_WINDOW_MS=60000
# @root API_MEMORY_RATE_LIMIT_MAX
MEMORY_RATE_LIMIT_MAX=1000
# @root API_MEMORY_WRITE_RATE_LIMIT_MAX
MEMORY_WRITE_RATE_LIMIT_MAX=300
# @root API_MEMORY_RECALL_RATE_LIMIT_MAX
MEMORY_RECALL_RATE_LIMIT_MAX=300
# @root API_SOURCE_JOURNAL_RATE_LIMIT_WINDOW_MS
SOURCE_JOURNAL_RATE_LIMIT_WINDOW_MS=60000
# @root API_SOURCE_JOURNAL_RATE_LIMIT_MAX
SOURCE_JOURNAL_RATE_LIMIT_MAX=10000
# @root API_RATE_LIMIT_STORE
RATE_LIMIT_STORE=memory
# @root API_RATE_LIMIT_REDIS_URL
RATE_LIMIT_REDIS_URL=
# @root API_CACHE_STORE
CACHE_STORE=memory
# @root API_CACHE_REDIS_URL
CACHE_REDIS_URL=
# @root API_GRAPH_CACHE_TTL_SECONDS
GRAPH_CACHE_TTL_SECONDS=5
# @root API_GRAPH_UPDATE_DEBOUNCE_MS
GRAPH_UPDATE_DEBOUNCE_MS=1000
# @root API_MEMORY_EVENT_GRAPH_UPDATE_DEBOUNCE_MS
MEMORY_EVENT_GRAPH_UPDATE_DEBOUNCE_MS=100

# Bound persistent collaboration streams globally and per authenticated
# principal. Realtime fanout and replay use the durable collaboration protocol.
COLLABORATION_REALTIME_STREAM_MAX_CLIENTS=1000
COLLABORATION_REALTIME_STREAM_MAX_CLIENTS_PER_PRINCIPAL=6
# @root API_COOKIE_SECURE
COOKIE_SECURE=false
# @root KOED_BACKUP_STATUS_PATH
KOED_BACKUP_STATUS_PATH=
# @root KOED_BACKUP_MAX_AGE_SECONDS
KOED_BACKUP_MAX_AGE_SECONDS=86400
# @root KOED_OPS_REQUEST_METRICS_STATUS_PATH
KOED_OPS_REQUEST_METRICS_STATUS_PATH=
# @root KOED_OPS_REQUEST_METRICS_MAX_AGE_SECONDS
KOED_OPS_REQUEST_METRICS_MAX_AGE_SECONDS=300
# @root KOED_OPS_MAX_RSS_BYTES
KOED_OPS_MAX_RSS_BYTES=1610612736
# @root KOED_OPS_OPERATOR_EMAILS
KOED_OPS_OPERATOR_EMAILS=
# Dedicated machine identity for the private OpenMetrics endpoint.
# @root KOED_OPS_METRICS_TOKEN
KOED_OPS_METRICS_TOKEN=replace_with_generated_ops_metrics_token
# @root KOED_RUNBOOK_BASE_URL
KOED_RUNBOOK_BASE_URL=

# @root WORKOS_AUTHKIT_ENABLED
WORKOS_AUTHKIT_ENABLED=false
# @root WORKOS_CLIENT_ID
WORKOS_CLIENT_ID=
# @root WORKOS_API_KEY
WORKOS_API_KEY=
# @root WORKOS_REDIRECT_URI
WORKOS_REDIRECT_URI=
# @root WORKOS_PROVIDER_ENVIRONMENT
WORKOS_PROVIDER_ENVIRONMENT=default
# @root omit
WORKOS_API_BASE_URL=https://api.workos.com

# @root omit
KOED_ALLOW_PUBLIC_REGISTRATION=false
# Public browser-reachable origin of this API. No separate browser service.
BROWSER_PUBLIC_URL=
