# Embedding service dev environment
# Values here use the names read by the TypeScript service directly.

# @root EMBEDDING_MODEL_KEY
MODEL_KEY=qwen3-0.6b
# @root omit
MODEL_PATH=
EMBEDDING_SERVICE_TOKEN=replace_with_generated_embedding_service_token
# Shared koed-server/Desktop preference; service-specific policy below takes precedence.
# @root KOED_HARDWARE_ACCELERATION
KOED_HARDWARE_ACCELERATION=auto
# @root KOED_EMBEDDING_ACCELERATION
KOED_EMBEDDING_ACCELERATION=auto
# Optional exact llama-server device id, such as CUDA0.
# @root KOED_EMBEDDING_DEVICE
KOED_EMBEDDING_DEVICE=
# Unload an accelerated embedding model after this many idle seconds. Zero disables unloading.
# @root KOED_EMBEDDING_GPU_IDLE_UNLOAD_SECONDS
KOED_EMBEDDING_GPU_IDLE_UNLOAD_SECONDS=300
# @root KOED_EMBEDDING_RUNTIME_VERSION
KOED_EMBEDDING_RUNTIME_VERSION=unknown
# @root EMBEDDING_LOG_LEVEL
LOG_LEVEL=info
EMBEDDING_BATCH_LIMIT=16
EMBEDDING_MAX_TOKENS=4096
# Transport and abuse guards; semantic chunking uses token limits.
EMBEDDING_MAX_TEXT_CHARS=200000
EMBEDDING_MAX_REQUEST_CHARS=1000000
# @root EMBEDDING_LLAMA_N_CTX
LLAMA_N_CTX=8192
# @root EMBEDDING_LLAMA_N_THREADS
LLAMA_N_THREADS=
# @root EMBEDDING_LLAMA_N_BATCH
LLAMA_N_BATCH=8192
# @root EMBEDDING_LLAMA_BATCH_TOKEN_HEADROOM
LLAMA_BATCH_TOKEN_HEADROOM=8
# @root EMBEDDING_LLAMA_N_UBATCH
LLAMA_N_UBATCH=512
# @root EMBEDDING_LLAMA_PARALLEL
LLAMA_PARALLEL=1
LLAMA_SERVER_BINARY=/opt/llama.cpp/llama-server
LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=180
LLAMA_EMBEDDING_SERVER_PORT=18080
