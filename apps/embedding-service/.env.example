# Embedding service dev environment
# Values here use the names read by app.py directly.

# @root EMBEDDING_MODEL_KEY
MODEL_KEY=qwen3-0.6b
# @root omit
MODEL_PATH=
EMBEDDING_SERVICE_TOKEN=replace_with_generated_embedding_service_token
# @root EMBEDDING_LOG_LEVEL
LOG_LEVEL=info
EMBEDDING_BATCH_LIMIT=16
EMBEDDING_MAX_TOKENS=4096
# Transport and abuse guards; semantic chunking uses token limits.
EMBEDDING_MAX_TEXT_CHARS=200000
EMBEDDING_MAX_REQUEST_CHARS=1000000
# @root EMBEDDING_LLAMA_N_CTX
LLAMA_N_CTX=32000
# @root EMBEDDING_LLAMA_N_THREADS
LLAMA_N_THREADS=
# @root EMBEDDING_LLAMA_N_BATCH
LLAMA_N_BATCH=512
EMBEDDING_SUPPRESS_LLAMA_WARNINGS=true
# Leave blank to disable reranking.
# @root EMBEDDING_RERANKER_KEY
RERANKER_KEY=
# @root EMBEDDING_RERANKER_BATCH_LIMIT
RERANKER_BATCH_LIMIT=100
