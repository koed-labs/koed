# Worker dev environment
# Values here use the names read by the worker process directly.

# @root WORKER_NODE_ENV=production
NODE_ENV=development

WORKER_LOG_LEVEL=info
WORKER_LOG_FILE=
WORKER_LOG_DESTINATION=

# Docker compose derives these from the Postgres and Redis services.
# @root omit
DATABASE_URL=postgres://koed:koed@localhost:15432/koed
# Redis is required when WORK_QUEUE_BACKEND=bullmq.
# @root omit
REDIS_URL=redis://localhost:6379
# @root WORK_QUEUE_BACKEND
WORK_QUEUE_BACKEND=bullmq

# @root API_DATA_ENCRYPTION_KEY
DATA_ENCRYPTION_KEY=replace_with_generated_32_byte_base64_key

# Docker compose derives this from the embedding-service service.
# @root omit
EMBEDDING_SERVICE_URL=http://localhost:8000
# @root omit
EMBEDDING_SERVICE_TOKEN=replace_with_generated_embedding_service_token
# @root EMBEDDING_SERVICE_HEALTH_TIMEOUT_MS
EMBEDDING_SERVICE_HEALTH_TIMEOUT_MS=1000
EMBEDDING_REQUEST_TIMEOUT_MS=900000
EMBEDDING_MAX_TEXT_CHARS=200000
EMBEDDING_MAX_REQUEST_CHARS=1000000
# The optional Docker Compose external starter gets these from the embedding-service and API examples.
# @root EMBEDDING_MODEL_KEY
EMBEDDING_MODEL=qwen3-0.6b
# Leave blank to disable reranking.
# @root EMBEDDING_RERANKER_KEY
RERANKER_KEY=
MEMORY_RAW_PROJECTION_INTERVAL_MS=5000
MEMORY_RAW_PROJECTION_BATCH_LIMIT=1000
MEMORY_RAW_PROJECTION_ACTOR_LIMIT=10
# Historical imports only project one batch when live capture and interactive
# Questions have no pending pressure. API readiness URL is required for admission.
MEMORY_HISTORICAL_IMPORT_BATCH_ROWS=100
MEMORY_HISTORICAL_IMPORT_BATCH_BYTES=1000000
MEMORY_HISTORICAL_IMPORT_BATCH_RUNTIME_MS=15000
MEMORY_HISTORICAL_IMPORT_CONCURRENCY=1
MEMORY_HISTORICAL_IMPORT_LIVE_BACKLOG_MAX=0
MEMORY_HISTORICAL_IMPORT_INTERACTIVE_BACKLOG_MAX=0
MEMORY_HISTORICAL_IMPORT_API_READY_URL=
MEMORY_HISTORICAL_IMPORT_API_READY_TIMEOUT_MS=1000
MEMORY_EVENT_MAX_TOKENS=2048
MEMORY_AGENT_TURN_STALE_MS=900000
# @root SEMANTIC_MEMORY_REBUILD_DEBOUNCE_MS
SEMANTIC_MEMORY_REBUILD_DEBOUNCE_MS=300000

# Backfill script only; Docker Compose external starter does not consume it.
# @root omit
EMBEDDING_BACKFILL_BATCH=500
