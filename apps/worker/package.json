{
  "name": "@koed/worker",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embedding-workflow": {
      "types": "./dist/embedding-workflow.d.ts",
      "import": "./dist/embedding-workflow.js"
    }
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "embeddings:backfill": "tsx src/backfill-embeddings.ts",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@koed/core": "workspace:*",
    "@koed/db": "workspace:*",
    "@koed/mcp-server": "workspace:*",
    "@koed/shared": "workspace:*",
    "bullmq": "^5.76.9",
    "dotenv": "^17.2.3",
    "ioredis": "^5.10.1",
    "pino": "^10.3.1",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "tsx": "^4.22.1"
  }
}
