# History browser dev environment
# Values here use the names read by the wrapper script and Vite app directly.

# @root CONSOLE_NODE_ENV=production
NODE_ENV=development
# @root HISTORY_WEB_PORT
HISTORY_WEB_PORT=5174
# @root CONSOLE_API_BASE_URL
VITE_API_BASE_URL=http://localhost:3000
# @root CONSOLE_API_BASE_URL
VITE_KOED_API_BASE_URL=http://localhost:3000

# Optional dev convenience token exposed to browser code when set.
# @root omit
VITE_KOED_API_TOKEN=

# Required only when syncing/building the private history browser source.
# @root GITHUB_TOKEN
GITHUB_TOKEN=replace_with_github_token_that_can_read_koed_history_browser
HISTORY_BROWSER_REPO=https://github.com/koed-labs/koed-history-browser.git
HISTORY_BROWSER_REF=main
