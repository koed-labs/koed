{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "erasableSyntaxOnly": false,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@koed/koed-server": ["packages/koed-server/dist/index.d.ts"],
      "@koed/shared": ["packages/shared/dist/index.d.ts"],
      "@koed/shared/collaboration": [
        "packages/shared/dist/collaboration-contract.d.ts"
      ],
      "@koed/shared/personal-desktop": [
        "packages/shared/dist/personal-desktop-contract.d.ts"
      ],
      "@koed/ui/theme": ["packages/ui/dist/theme.d.ts"]
    },
    "outDir": "dist-types",
    "rootDir": "src"
  },
  "references": [
    { "path": "../../packages/koed-server" },
    { "path": "../../packages/shared" },
    { "path": "../../packages/ui" }
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
