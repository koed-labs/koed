# HQ is on by default. Set KOED_DESKTOP_HQ_ENABLED=false in Desktop's launch
# environment to use the previous Desktop interface.
# Desktop reads this flag from its inherited process environment.
# Desktop does not automatically load the repository-root or Desktop .env
# files.
# @root KOED_DESKTOP_HQ_ENABLED=true
KOED_DESKTOP_HQ_ENABLED=true
