# Experimental, empty HQ shell; the default is off.
# Desktop reads this flag from its inherited process environment. To enable it,
# launch with: KOED_DESKTOP_HQ_ENABLED=true pnpm desktop:start
# Desktop does not automatically load the repository-root or Desktop .env
# files.
# @root KOED_DESKTOP_HQ_ENABLED=false
KOED_DESKTOP_HQ_ENABLED=false
