# Optional account configuration for source-run Desktop only.
# Root .env uses DESKTOP_ACCOUNT_*; Electron maps these to KOED_ACCOUNT_*.
# Explicit process-environment values take precedence. No WorkOS API key is needed.
# Packaged releases use generated account-config.json and do not read this file.

# @root DESKTOP_ACCOUNT_ENABLED
KOED_ACCOUNT_ENABLED=false
# @root DESKTOP_ACCOUNT_CLIENT_ID
KOED_ACCOUNT_CLIENT_ID=
# @root DESKTOP_ACCOUNT_ENVIRONMENT
KOED_ACCOUNT_ENVIRONMENT=staging
# @root DESKTOP_ACCOUNT_LOGIN_MODE
KOED_ACCOUNT_LOGIN_MODE=forwarder
# Full HTTPS callback URL, required only for forwarder mode.
# @root DESKTOP_ACCOUNT_FORWARDER_URL
KOED_ACCOUNT_FORWARDER_URL=
