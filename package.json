{
  "name": "koed",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "explorer:dev": "pnpm --filter @koed/explorer dev",
    "explorer:build": "pnpm --filter @koed/explorer build",
    "explorer:preview": "pnpm --filter @koed/explorer preview",
    "explorer:typecheck": "pnpm --filter @koed/explorer typecheck",
    "api-token:create": "pnpm --filter @koed/db api-token:create",
    "api-token:list": "pnpm --filter @koed/db api-token:list",
    "api-token:revoke": "pnpm --filter @koed/db api-token:revoke",
    "db:migrate:check": "pnpm --filter @koed/db migrate:check",
    "db:migrate:smoke": "pnpm --filter @koed/db migrate:smoke",
    "embeddings:backfill": "pnpm --filter @koed/worker embeddings:backfill",
    "eval": "pnpm --filter @koed/evals eval",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-product-release.mjs --consume-changesets",
    "release:notes": "node scripts/product-release-notes.mjs",
    "codex:configure": "node scripts/configure-codex.mjs",
    "codex:verify-capture": "node scripts/verify-codex-capture-hook.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:sync": "node scripts/sync-app-env-examples.mjs",
    "env:sync:check": "node scripts/sync-app-env-examples.mjs --check",
    "smoke:lcm": "node scripts/lcm-smoke-test.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm -r --workspace-concurrency=1 test",
    "test:python": "node scripts/python-check.mjs",
    "setup:python": "node scripts/python-setup.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b && pnpm --filter @koed/explorer typecheck",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "node scripts/verify.mjs",
    "fmt": "pnpm fmt:prettier && pnpm fmt:python",
    "fmt:check": "pnpm fmt:prettier:check && pnpm fmt:python:check",
    "fmt:prettier": "prettier --write .",
    "fmt:prettier:check": "prettier --check .",
    "fmt:python": "cd apps/embedding-service && .venv/bin/ruff format .",
    "fmt:python:check": "cd apps/embedding-service && .venv/bin/ruff format --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
