{
  "name": "koed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "console:dev": "pnpm --filter @codex-memory/console dev",
    "console:build": "pnpm --filter @codex-memory/console build",
    "history:dev": "pnpm --filter @codex-memory/history-browser dev",
    "history:build": "pnpm --filter @codex-memory/history-browser build",
    "embeddings:backfill": "pnpm --filter @codex-memory/worker embeddings:backfill",
    "eval": "pnpm --filter @codex-memory/evals eval",
    "codex:configure": "node scripts/configure-codex.mjs",
    "setup:env": "node scripts/setup-env.mjs",
    "smoke:lcm": "node scripts/lcm-smoke-test.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:python": "node scripts/python-check.mjs",
    "setup:python": "node scripts/python-setup.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "node scripts/verify.mjs",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
