{
  "name": "koed",
  "version": "0.6.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "api-token:create": "pnpm --filter @koed/db api-token:create",
    "api-token:list": "pnpm --filter @koed/db api-token:list",
    "api-token:revoke": "pnpm --filter @koed/db api-token:revoke",
    "koed-server": "pnpm --filter @koed/koed-server",
    "runtime:install": "node packages/koed-server/dist/cli.js runtime install --provider homebrew --dependency-mode bundled-local --json",
    "runtime:status": "node packages/koed-server/dist/cli.js runtime status --provider homebrew --json",
    "models:install:embedding": "node packages/koed-server/dist/cli.js models install --kind embedding --json",
    "models:install:privacy": "node packages/koed-server/dist/cli.js models install --kind privacy --json",
    "local:setup": "pnpm env:setup && pnpm build && pnpm runtime:install && pnpm models:install:embedding && pnpm models:install:privacy",
    "desktop:build": "pnpm --filter @koed/desktop build",
    "desktop:dev": "pnpm --filter @koed/desktop dev",
    "desktop:package": "pnpm --filter @koed/desktop package",
    "desktop:package:mac": "pnpm --filter @koed/desktop package:mac",
    "desktop:package:linux": "pnpm --filter @koed/desktop package:linux",
    "desktop:package:internal:mac": "pnpm --filter @koed/desktop package:internal:mac",
    "desktop:package:release": "pnpm --filter @koed/desktop package:release",
    "desktop:package:smoke": "pnpm --filter @koed/desktop package:smoke",
    "desktop:package:smoke:mac": "pnpm --filter @koed/desktop package:smoke:mac",
    "desktop:start": "pnpm --filter @koed/desktop start",
    "source-runtime:prepare": "node scripts/source-runtime-build.mjs prepare",
    "source-runtime:check": "node scripts/source-runtime-build.mjs check",
    "native-runtime:stage:homebrew": "node scripts/stage-native-runtime-homebrew.mjs",
    "koed-server:package": "node scripts/build-koed-server-package.mjs",
    "release-artifact:inspect": "node scripts/inspect-release-artifact.mjs",
    "codex:bootstrap": "node scripts/codex-bootstrap.mjs",
    "codex:doctor": "node packages/mcp-server/dist/cli.js doctor",
    "codex:setup": "node scripts/clients-bootstrap.mjs",
    "clients:bootstrap": "node scripts/clients-bootstrap.mjs",
    "db:migrate:check": "pnpm --filter @koed/db migrate:check",
    "db:migrate:acceptance": "pnpm --filter @koed/db migrate:acceptance",
    "db:migrate:smoke": "pnpm db:migrate:acceptance",
    "embeddings:backfill": "pnpm --filter @koed/worker embeddings:backfill",
    "assets:embedding": "pnpm --filter @koed/koed-server exec koed-server models install --kind embedding",
    "assets:privacy": "pnpm --filter @koed/koed-server exec koed-server models install --kind privacy",
    "assets:reranker": "pnpm --filter @koed/koed-server exec koed-server models install --kind reranker",
    "eval": "pnpm --filter @koed/evals eval",
    "eval:lcm-summary": "pnpm --filter @koed/evals eval:lcm-summary:live",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-product-release.mjs --consume-changesets",
    "release:check": "node scripts/check-product-release.mjs",
    "release:notes": "node scripts/product-release-notes.mjs",
    "codex:configure": "node scripts/configure-codex.mjs",
    "claude:configure": "node scripts/configure-claude.mjs",
    "pi:configure": "node scripts/configure-pi.mjs",
    "pi:check": "node scripts/configure-pi.mjs --check",
    "pi:remove": "node scripts/configure-pi.mjs --remove",
    "codex:verify-capture": "node scripts/verify-codex-capture-hook.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "env:sync": "node scripts/sync-app-env-examples.mjs",
    "env:sync:check": "node scripts/sync-app-env-examples.mjs --check",
    "smoke:lcm": "node scripts/lcm-smoke-test.mjs",
    "smoke:personal-joined": "node scripts/personal-joined-smoke.mjs",
    "smoke:pds-replication": "node scripts/personal-device-replication-smoke.mjs",
    "team-fixture:reset": "node scripts/team-saas-fixture.mjs reset",
    "team-fixture:seed": "node scripts/team-saas-fixture.mjs seed",
    "team-fixture:validate": "node scripts/team-saas-fixture.mjs validate",
    "pds-fixture:validate": "node scripts/personal-device-sync-fixture.mjs",
    "pds-pairing:e2e": "node scripts/personal-device-pairing-e2e.mjs",
    "team-launch:validate": "node scripts/team-saas-launch-validation.mjs",
    "approval-activity:measure-sharing": "pnpm --filter @koed/shared build && node scripts/approval-activity-sharing-performance.mjs",
    "multi-device:prepare": "node scripts/multi-device-profile.mjs",
    "multi-device:validate": "node scripts/multi-device-dogfood.mjs",
    "hosted:backup": "node scripts/hosted-backup.mjs",
    "hosted:db-roles": "node scripts/hosted-db-roles.mjs",
    "hosted:encryption-rewrap": "node scripts/hosted-encryption-rewrap-command.mjs",
    "hosted:capacity": "node scripts/hosted-capacity.mjs",
    "embedding:benchmark": "pnpm --filter @koed/embedding-service build && node scripts/embedding-acceleration-benchmark.mjs",
    "smoke:bundled-local": "node scripts/bundled-local-smoke.mjs",
    "native-runtime:build:macos-arm64": "node scripts/native-runtime/build-macos-arm64.mjs",
    "native-runtime:build:linux-x64": "node scripts/native-runtime/build-linux-x64.mjs",
    "native-runtime:build:llama-cuda-linux-x64": "node scripts/native-runtime/build-llama-cuda-linux-x64.mjs",
    "privacy:accelerator-smoke": "node scripts/privacy-shared-accelerator-smoke.mjs",
    "native-runtime:validate": "node scripts/native-runtime/validate-runtime.mjs",
    "native-runtime:validate:wsl": "node scripts/native-runtime/validate-wsl.mjs",
    "test": "node --test scripts/*.test.mjs && pnpm -r --workspace-concurrency=1 test",
    "test:required-suites": "node scripts/required-test-suites.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "verify": "node scripts/verify.mjs",
    "fmt": "pnpm fmt:prettier",
    "fmt:check": "pnpm fmt:prettier:check",
    "fmt:prettier": "prettier --write .",
    "fmt:prettier:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.8.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "yaml": "^2.9.0"
  }
}
