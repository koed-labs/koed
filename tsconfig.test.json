{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.test.ts",
    "apps/**/*.test.tsx",
    "apps/**/*.spec.ts",
    "apps/**/*.spec.tsx",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx",
    "packages/**/*.spec.ts",
    "packages/**/*.spec.tsx"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
