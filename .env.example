# Postgres service
POSTGRES_DB=koed
POSTGRES_USER=koed
POSTGRES_PASSWORD=koed
POSTGRES_HOST_PORT=15432

# Docker service host ports
API_HOST_PORT=3000
CONSOLE_HOST_PORT=5173
HISTORY_WEB_HOST_PORT=5174

# BEGIN GENERATED APP ENV EXAMPLES
# Generated by `pnpm env:sync` from apps/*/.env.example.
# Edit the app .env.example files, then rerun the sync script.

# Shared app config
EMBEDDING_MODEL_KEY=qwen3-0.6b
EMBEDDING_RERANKER_KEY=
MEMORY_VECTOR_CANDIDATE_LIMIT=20
MEMORY_LCM_LEAF_EVENT_THRESHOLD=100
MEMORY_LCM_LEAF_TOKEN_THRESHOLD=32000
MEMORY_LCM_FRESH_EVENT_TAIL=10
MEMORY_LCM_DEPTH1_FANOUT=20

# API app
API_NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
API_LOG_LEVEL=info
API_DATA_ENCRYPTION_KEY=replace_with_generated_32_byte_base64_key
API_TOKEN_PEPPER=replace_with_generated_token_pepper
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
API_REQUEST_BODY_LIMIT_BYTES=262144
API_AUTH_RATE_LIMIT_WINDOW_MS=60000
API_AUTH_RATE_LIMIT_MAX=20
API_MEMORY_RATE_LIMIT_WINDOW_MS=60000
API_MEMORY_RATE_LIMIT_MAX=1000
API_MEMORY_READ_RATE_LIMIT_WINDOW_MS=60000
API_MEMORY_READ_RATE_LIMIT_MAX=1000
API_MEMORY_WRITE_RATE_LIMIT_WINDOW_MS=60000
API_MEMORY_WRITE_RATE_LIMIT_MAX=300
API_MEMORY_RECALL_RATE_LIMIT_WINDOW_MS=60000
API_MEMORY_RECALL_RATE_LIMIT_MAX=300
API_RATE_LIMIT_STORE=memory
API_RATE_LIMIT_REDIS_URL=
API_CACHE_STORE=memory
API_CACHE_REDIS_URL=
API_GRAPH_CACHE_TTL_SECONDS=5
API_GRAPH_UPDATE_DEBOUNCE_MS=1000
API_MEMORY_EVENT_GRAPH_UPDATE_DEBOUNCE_MS=100
API_COOKIE_SECURE=false

# Worker app
WORKER_NODE_ENV=production

# Embedding service app
EMBEDDING_SERVICE_TOKEN=replace_with_generated_embedding_service_token
EMBEDDING_BATCH_LIMIT=16
EMBEDDING_MAX_TOKENS=32768
EMBEDDING_MAX_TEXT_CHARS=200000
EMBEDDING_MAX_REQUEST_CHARS=1000000
EMBEDDING_LLAMA_N_CTX=32768
EMBEDDING_LLAMA_N_THREADS=
EMBEDDING_LLAMA_N_BATCH=512
EMBEDDING_SUPPRESS_LLAMA_WARNINGS=true
EMBEDDING_RERANKER_BATCH_LIMIT=100

# Console app
CONSOLE_NODE_ENV=production
CONSOLE_PORT=5173
CONSOLE_API_BASE_URL=http://localhost:3000

# History browser app
HISTORY_WEB_PORT=5174
GITHUB_TOKEN=replace_with_github_token_that_can_read_koed_history_browser
HISTORY_BROWSER_REPO=https://github.com/koed-labs/koed-history-browser.git
HISTORY_BROWSER_REF=main

# END GENERATED APP ENV EXAMPLES

# Local AI-client integration values. These are copied into the client config, not
# consumed automatically by docker compose.
MEMORY_API_URL=http://localhost:3000
MEMORY_API_TOKEN=replace_with_console_created_token
MEMORY_HOOK_STRICT=false
MEMORY_HOOK_MAX_ITEMS=10
MEMORY_ANSWER_BRIDGE_ENABLED=true
MEMORY_ANSWER_BRIDGE_HOST=0.0.0.0
MEMORY_ANSWER_BRIDGE_PORT=3210
MEMORY_CODEX_APP_SERVER_BINARY=codex
MEMORY_ANSWER_PROVIDER=codex
MEMORY_ANSWER_MODEL=gpt-5.4-mini
MEMORY_ANSWER_REASONING_EFFORT=high
MEMORY_ANSWER_TIMEOUT_MS=120000
MEMORY_ANSWER_MAX_ATTEMPTS=2
MEMORY_ANSWER_PLANNING_MODE=planned
MEMORY_ANSWER_MAX_SEARCHES=3
MEMORY_ANSWER_MAX_EXPANSIONS=3
MEMORY_QUESTION_ANSWER_MAX_ATTEMPTS=3
MEMORY_QUESTION_ANSWER_LOCAL_LEASE_SECONDS=300
MEMORY_HOOK_TRIGGER_LCM_SUMMARY=true
MEMORY_HOOK_LCM_SUMMARY_DELAY_MS=10000
MEMORY_HOOK_LCM_SUMMARY_LIMIT=2
MEMORY_LCM_SUMMARY_MAX_PROMPT_TOKENS=48000
