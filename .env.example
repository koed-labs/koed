# Postgres service
POSTGRES_DB=koed
POSTGRES_USER=koed
# `pnpm env:setup` replaces this placeholder in `.env`.
POSTGRES_PASSWORD=replace_with_generated_postgres_password
POSTGRES_HOST_PORT=15432

# Used by local operator scripts; compose derives service DATABASE_URL values
# from the Postgres settings above.
# `pnpm env:setup` replaces this placeholder in `.env`.
DATABASE_URL=replace_with_generated_database_url

# koed-server control-plane mode. Source checkouts default to external.
# KOED_DEPLOYMENT_PROFILE describes the instance capability profile reported by
# /v1/capabilities. Supported values: developer, local_personal, private_vps,
# team_self_hosted, koed_managed_cloud.
# Uncomment KOED_DEPENDENCY_MODE=bundled-local to let koed-server start native
# Postgres + Embedding Service runtimes under KOED_HOME and use
# WORK_QUEUE_BACKEND=local unless explicitly overridden in the environment.
# KOED_DEPLOYMENT_PROFILE=developer
# KOED_RUNTIME_MODE=developer
# KOED_DEPENDENCY_MODE=bundled-local

# Local service host ports
API_HOST_PORT=3300
REDIS_HOST_PORT=16379
EMBEDDING_SERVICE_HOST_PORT=3800

# Explicit dependency URLs used by koed-server external mode. Bundled-local mode
# derives local URLs from the host ports above.
REDIS_URL=redis://localhost:16379
EMBEDDING_SERVICE_URL=http://localhost:3800

# Optional bundled-local model installer inputs. `koed-server models install`
# writes into KOED_MODELS_DIR when set, otherwise KOED_HOME/models.
KOED_MODELS_DIR=
KOED_EMBEDDING_MODEL_URL=
KOED_EMBEDDING_MODEL_SHA256=
KOED_RERANKER_MODEL_URL=
KOED_RERANKER_MODEL_SHA256=

# Optional native bundled-local Postgres runtime overrides. Bundled-local is
# native-only; KOED_BUNDLED_POSTGRES_MODE is deprecated and ignored.
KOED_BUNDLED_POSTGRES_MODE=
KOED_POSTGRES_BIN_DIR=
KOED_POSTGRES_DATA_DIR=
KOED_POSTGRES_RUN_DIR=
KOED_POSTGRES_LOG_PATH=

# Optional native bundled-local Embedding Service runtime overrides. Bundled-local
# is native-only; KOED_BUNDLED_EMBEDDING_MODE is deprecated and ignored.
KOED_BUNDLED_EMBEDDING_MODE=
KOED_EMBEDDING_LLAMA_SERVER_BIN=
KOED_EMBEDDING_HOST=
KOED_EMBEDDING_PORT=

