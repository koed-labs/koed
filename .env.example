# Postgres service
POSTGRES_DB=koed
POSTGRES_USER=koed
POSTGRES_PASSWORD=koed
POSTGRES_HOST_PORT=15432

# API service
API_NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=3000
API_HOST_PORT=3000
API_LOG_LEVEL=info

# Generate deployment-specific values with the README quickstart command.
# API_DATA_ENCRYPTION_KEY=<base64 32-byte key>
# API_TOKEN_PEPPER=<random server-side token pepper>
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_REQUEST_BODY_LIMIT_BYTES=262144
API_AUTH_RATE_LIMIT_WINDOW_MS=60000
API_AUTH_RATE_LIMIT_MAX=20
API_MEMORY_RATE_LIMIT_WINDOW_MS=60000
API_MEMORY_RATE_LIMIT_MAX=120
API_COOKIE_SECURE=false

# Console service
CONSOLE_NODE_ENV=production
CONSOLE_PORT=5173
CONSOLE_HOST_PORT=5173
CONSOLE_API_BASE_URL=http://localhost:3000

# Worker service
WORKER_NODE_ENV=production

# Memory runtime used by the API and worker services
MEMORY_MODE=codex_subscription
# Only set with MEMORY_MODE=server_synthesis for approved dev/test backend LLM calls.
# MEMORY_SERVER_SYNTHESIS_UNSAFE_ALLOW=1
MEMORY_VECTOR_CANDIDATE_LIMIT=20
MEMORY_RERANKING_ENABLED=false
MEMORY_LCM_LEAF_EVENT_THRESHOLD=5
MEMORY_LCM_LEAF_TOKEN_THRESHOLD=6000
MEMORY_LCM_FRESH_EVENT_TAIL=1
MEMORY_LCM_DEPTH1_FANOUT=2

# Embedding service
EMBEDDING_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B-GGUF
EMBEDDING_DIMENSIONS=1024
EMBEDDING_VERSION=local-qwen3-embedding-0.6b-gguf-v1
EMBEDDING_BATCH_LIMIT=16
EMBEDDING_MAX_TOKENS=32768
EMBEDDING_LLAMA_N_CTX=32768
EMBEDDING_RERANKER_ENABLED=false
EMBEDDING_RERANKER_MODEL=n24q02m/Qwen3-Reranker-0.6B-ONNX
EMBEDDING_RERANKER_BATCH_LIMIT=100

# Local AI-client integration values. These are copied into the client config, not
# consumed automatically by docker compose.
MEMORY_API_URL=http://localhost:3000
MEMORY_API_TOKEN=replace_with_console_created_token
